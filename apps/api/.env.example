# Klypse API — Environment
# Copy to .env and fill in real values

# See root .env.example for all variables.
# This file documents API-specific overrides only.

DATABASE_URL=postgresql://klypse:klypse_dev@localhost:5432/klypse_dev
REDIS_URL=redis://localhost:6379

API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

AUTH_SECRET=generate-a-random-64-char-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
