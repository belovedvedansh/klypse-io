# ============================================
# Klypse.io — Environment Configuration
# ============================================
# Copy to .env and fill in values

NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://klypse:klypse_dev@localhost:5432/klypse_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Google OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=generate-a-random-64-char-secret-here
AUTH_URL=http://localhost:3000

# ---- Linked Accounts ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---- Storage ----
STORAGE_PROVIDER=local
# For S3-compatible storage:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
LOCAL_STORAGE_PATH=./storage

# ---- AI / Processing ----
OPENAI_API_KEY=
WHISPER_MODEL=base
REFRAME_MODEL=mediapipe

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Klypse

# ---- Quotas (defaults, admin-overridable) ----
DEFAULT_DAILY_EXPORT_LIMIT=5
DEFAULT_DAILY_PROCESSING_MINUTES=30
DEFAULT_MAX_SOURCE_DURATION_MINUTES=120
DEFAULT_MAX_ACTIVE_JOBS=2
DEFAULT_RETENTION_DAYS_RAW=3
DEFAULT_RETENTION_DAYS_EXPORT=14

# ---- Feature Flags ----
FF_WATERMARK_ENABLED=true
FF_MEME_OVERLAY=false
FF_SFX_SUGGESTIONS=false
FF_MUSIC_SUGGESTIONS=false
FF_ADVANCED_REFRAME=true
FF_MULTI_LANGUAGE=true
